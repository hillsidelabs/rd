package modules

import (
	"fmt"
	"time"

	"github.com/axzilla/templui/components"
)

type LogType string

const (
	LogTypeStdout  LogType = "stdout"
	LogTypeStderr  LogType = "stderr"
	LogTypeInfo    LogType = "info"
	LogTypeError   LogType = "error"
	LogTypeSuccess LogType = "success"
	LogTypeWarning LogType = "warning"
	LogTypeCommand LogType = "command"
)

type CommandLogLine struct {
	Content string
	Type    LogType
	Time    time.Time
}

type CommandStatusProps struct {
	ID          string
	Title       string
	Command     string
	Logs        []CommandLogLine
	IsRunning   bool
	ExitCode    int
	MaxHeight   string
	AutoScroll  bool
	ShowCopyBtn bool
	Class       string
	SSEUrl      string
}

templ CommandStatusLogLine(log CommandLogLine) {
	<div class={ getLogLineClass(log.Type) }>
		if !log.Time.IsZero() {
			<span class="text-gray-500 mr-2">{ formatTime(log.Time) }</span>
		}
		if log.Type == LogTypeCommand {
			<span class="text-blue-400">$</span> <span class="text-green-400">{ log.Content }</span>
		} else {
			<span>{ log.Content }</span>
		}
	</div>
}

templ CommandStatus(props CommandStatusProps) {
	<div
		id={ props.ID }
		class={ "terminal-container rounded-md border overflow-hidden " + props.Class }
		data-autoscroll={ boolToString(props.AutoScroll) }
	>
		<div class="bg-muted/50 px-4 py-2 border-b flex justify-between items-center">
			<div class="flex items-center gap-2">
				if props.IsRunning {
					<div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
				} else if props.ExitCode == 0 {
					<div class="w-2 h-2 rounded-full bg-green-500"></div>
				} else {
					<div class="w-2 h-2 rounded-full bg-red-500"></div>
				}
				<h3 class="font-medium">{ props.Title }</h3>
			</div>
			<div class="text-xs text-muted-foreground font-mono">
				{ props.Command }
			</div>
		</div>
		<div
			class="bg-black text-white font-mono text-sm p-4 overflow-y-auto terminal-logs"
			style={ "max-height:" + getMaxHeight(props.MaxHeight) }
			id={ props.ID + "-logs" }
			if props.SSEUrl != "" {
				hx-ext="sse"
				sse-connect={ props.SSEUrl }
				sse-swap="log"
				hx-swap="beforeend"
				sse-close="close"
			}
		>
			for _, log := range props.Logs {
				@CommandStatusLogLine(log)
			}
		</div>
		if !props.IsRunning {
			<div class="bg-muted/30 px-4 py-2 border-t text-sm flex justify-between">
				<span>Exit code: { intToString(props.ExitCode) }</span>
				if props.ShowCopyBtn {
					<div>
						@components.Button(components.ButtonProps{
							Size:    "small",
							Variant: components.ButtonVariantOutline,
							Class:   "h-7",
						}) {
							Copy Output
						}
					</div>
				}
			</div>
		}
	</div>
	<style>
		.terminal-logs {
			line-height: 1.4;
		}
		@keyframes blink {
			0%, 100% { opacity: 1; }
			50% { opacity: 0; }
		}
		.animate-blink {
			animation: blink 1s step-end infinite;
		}
	</style>
}

// Example usage of the component
templ CommandStatusExample() {
	@CommandStatus(CommandStatusProps{
		ID:          "example-terminal",
		Title:       "Deploy Command",
		Command:     "ssh user@server 'docker-compose up -d'",
		IsRunning:   true,
		AutoScroll:  true,
		ShowCopyBtn: true,
		MaxHeight:   "300px",
		Logs: []CommandLogLine{
			{Content: "ssh user@server 'docker-compose up -d'", Type: LogTypeCommand, Time: time.Now().Add(-10 * time.Second)},
			{Content: "Connecting to server...", Type: LogTypeInfo, Time: time.Now().Add(-8 * time.Second)},
			{Content: "SSH connection established", Type: LogTypeSuccess, Time: time.Now().Add(-6 * time.Second)},
			{Content: "Running docker-compose up -d", Type: LogTypeInfo, Time: time.Now().Add(-5 * time.Second)},
			{Content: "Creating network \"app_default\" with the default driver", Type: LogTypeStdout, Time: time.Now().Add(-4 * time.Second)},
			{Content: "Creating app_db_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-3 * time.Second)},
			{Content: "Creating app_redis_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-2 * time.Second)},
			{Content: "Creating app_web_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-1 * time.Second)},
		},
	})
}

// Helper functions
func getMaxHeight(height string) string {
	if height == "" {
		return "400px"
	}
	return height
}

func getLogLineClass(logType LogType) string {
	switch logType {
	case LogTypeError:
		return "text-red-400"
	case LogTypeSuccess:
		return "text-green-400"
	case LogTypeInfo:
		return "text-blue-400"
	case LogTypeStderr:
		return "text-yellow-400"
	case LogTypeWarning:
		return "text-orange-400"
	default:
		return ""
	}
}

func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func intToString(i int) string {
	return fmt.Sprintf("%d", i)
}

func formatTime(t time.Time) string {
	return t.Format("15:04:05")
}
