package pages

import (
	"github.com/axzilla/templui/components"
	"github.com/hillsidelabs/rd/infra"
	"github.com/hillsidelabs/rd/web/ui/layouts"
)

templ Infra(catalog *infra.Catalog) {
	@layouts.BaseLayout() {
		<div class="container mx-auto py-8">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-2xl font-bold">Infrastructure Management</h1>
				<div>
					@components.Button(components.ButtonProps{
						Class: "flex items-center gap-2",
					}) {
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus">
							<path d="M5 12h14"></path>
							<path d="M12 5v14"></path>
						</svg>
						Create New VM
					}
				</div>
			</div>
			if len(catalog.Hosts) == 0 {
				<div class="bg-card border rounded-lg p-8 text-center">
					<h3 class="text-lg font-medium mb-2">No hosts found</h3>
					<p class="text-muted-foreground mb-4">You don't have any infrastructure hosts configured yet.</p>
					@components.Button(components.ButtonProps{}) {
						Create your first host
					}
				</div>
			} else {
				<div class="overflow-hidden border rounded-lg">
					<table class="w-full text-sm">
						<thead class="bg-muted/50">
							<tr>
								<th class="px-4 py-3 text-left font-medium">Name</th>
								<th class="px-4 py-3 text-left font-medium">Hostname</th>
								<th class="px-4 py-3 text-left font-medium">IP Address</th>
								<th class="px-4 py-3 text-left font-medium">Private IP</th>
								<th class="px-4 py-3 text-left font-medium">Provider</th>
								<th class="px-4 py-3 text-left font-medium">Tags</th>
								<th class="px-4 py-3 text-left font-medium">Actions</th>
							</tr>
						</thead>
						<tbody>
							for i, host := range catalog.Hosts {
								<tr class={ templ.KV("bg-muted/20", i%2 == 1) }>
									<td class="px-4 py-3 font-medium">{ host.Name }</td>
									<td class="px-4 py-3">{ host.Hostname }</td>
									<td class="px-4 py-3">{ host.IP }</td>
									<td class="px-4 py-3">{ host.PrivateIP }</td>
									<td class="px-4 py-3">
										if host.Infrastructure != nil {
											{ host.Infrastructure.Provider() }
										} else {
											<span class="text-muted-foreground">-</span>
										}
									</td>
									<td class="px-4 py-3">
										<div class="flex flex-wrap gap-1">
											for _, tag := range host.Tags {
												<span class="px-2 py-0.5 bg-primary/10 text-primary rounded-full text-xs">{ tag }</span>
											}
										</div>
									</td>
									<td class="px-4 py-3">
										<div class="flex items-center gap-2">
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8",
											}) {
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil">
													<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
													<path d="m15 5 4 4"></path>
												</svg>
												<span class="sr-only">Edit</span>
											}
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8",
											}) {
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause">
													<rect width="4" height="16" x="6" y="4"></rect>
													<rect width="4" height="16" x="14" y="4"></rect>
												</svg>
												<span class="sr-only">Pause</span>
											}
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8 text-destructive hover:bg-destructive/10",
											}) {
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2">
													<path d="M3 6h18"></path>
													<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
													<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
													<line x1="10" x2="10" y1="11" y2="17"></line>
													<line x1="14" x2="14" y1="11" y2="17"></line>
												</svg>
												<span class="sr-only">Delete</span>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<!-- Create VM Modal (hidden by default) -->
			<div id="create-vm-modal" class="hidden">
				<div class="fixed inset-0 bg-black/50 z-40"></div>
				<div class="fixed inset-0 z-50 flex items-center justify-center">
					<div class="bg-background rounded-lg shadow-lg w-full max-w-md">
						<div class="p-6">
							<h3 class="text-lg font-semibold mb-4">Create New VM</h3>
							<form class="space-y-4">
								<div>
									<label for="vm-name" class="block text-sm font-medium mb-1">Name</label>
									<input type="text" id="vm-name" class="w-full px-3 py-2 border rounded-md" placeholder="Enter VM name"/>
								</div>
								<div>
									<label for="vm-provider" class="block text-sm font-medium mb-1">Provider</label>
									<select id="vm-provider" class="w-full px-3 py-2 border rounded-md">
										<option value="aws">AWS</option>
										<option value="digitalocean">Digital Ocean</option>
									</select>
								</div>
								<div>
									<label for="vm-type" class="block text-sm font-medium mb-1">Instance Type</label>
									<select id="vm-type" class="w-full px-3 py-2 border rounded-md">
										<option value="t2.micro">t2.micro</option>
										<option value="t2.small">t2.small</option>
										<option value="t2.medium">t2.medium</option>
									</select>
								</div>
								<div>
									<label for="vm-tags" class="block text-sm font-medium mb-1">Tags (comma separated)</label>
									<input type="text" id="vm-tags" class="w-full px-3 py-2 border rounded-md" placeholder="web,production"/>
								</div>
								<div class="flex justify-end gap-2 pt-4">
									<button type="button" class="px-4 py-2 border rounded-md">Cancel</button>
									<button type="submit" class="px-4 py-2 bg-primary text-primary-foreground rounded-md">Create VM</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script>
			// Modal functionality would be implemented here
			document.addEventListener('DOMContentLoaded', () => {
				const createButtons = document.querySelectorAll('button:contains("Create")');
				const modal = document.getElementById('create-vm-modal');
				const cancelButton = modal.querySelector('button[type="button"]');
				
				createButtons.forEach(button => {
					button.addEventListener('click', () => {
						modal.classList.remove('hidden');
					});
				});
				
				cancelButton.addEventListener('click', () => {
					modal.classList.add('hidden');
				});
			});
		</script>
	}
}
