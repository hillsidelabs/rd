package modules

import (
	"fmt"
	"time"

	"github.com/axzilla/templui/components"
)

type LogType string

const (
	LogTypeStdout  LogType = "stdout"
	LogTypeStderr  LogType = "stderr"
	LogTypeInfo    LogType = "info"
	LogTypeError   LogType = "error"
	LogTypeSuccess LogType = "success"
	LogTypeWarning LogType = "warning"
	LogTypeCommand LogType = "command"
)

type CommandLogLine struct {
	Content string
	Type    LogType
	Time    time.Time
}

type CommandStatusProps struct {
	ID          string
	Title       string
	Command     string
	Logs        []CommandLogLine
	IsRunning   bool
	ExitCode    int
	MaxHeight   string
	AutoScroll  bool
	ShowCopyBtn bool
	Class       string
	JobID       string
}

templ CommandStatus(props CommandStatusProps) {
	<div
		id={ props.ID }
		class={ "terminal-container rounded-md border overflow-hidden " + props.Class }
		data-autoscroll={ boolToString(props.AutoScroll) }
		if props.JobID != "" {
			hx-ext="sse"
			sse-connect={ "/infra/vm/events?job=" + props.JobID }
			sse-swap="log"
		}
	>
		<div class="bg-muted/50 px-4 py-2 border-b flex justify-between items-center">
			<div class="flex items-center gap-2">
				if props.IsRunning {
					<div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
				} else if props.ExitCode == 0 {
					<div class="w-2 h-2 rounded-full bg-green-500"></div>
				} else {
					<div class="w-2 h-2 rounded-full bg-red-500"></div>
				}
				<h3 class="font-medium">{ props.Title }</h3>
			</div>
			<div class="text-xs text-muted-foreground font-mono">
				{ props.Command }
			</div>
		</div>
		<div
			class="bg-black text-white font-mono text-sm p-4 overflow-y-auto terminal-logs"
			style={ "max-height:" + getMaxHeight(props.MaxHeight) }
			id={ props.ID + "-logs" }
		>
			for _, log := range props.Logs {
				<div class={ getLogLineClass(log.Type) }>
					if !log.Time.IsZero() {
						<span class="text-gray-500 mr-2">{ formatTime(log.Time) }</span>
					}
					if log.Type == LogTypeCommand {
						<span class="text-blue-400">$</span> <span class="text-green-400">{ log.Content }</span>
					} else {
						<span>{ log.Content }</span>
					}
				</div>
			}
			if props.IsRunning {
				<div class="animate-pulse">
					<span class="text-green-400">$</span> <span class="animate-blink">_</span>
				</div>
			}
		</div>
		if !props.IsRunning {
			<div class="bg-muted/30 px-4 py-2 border-t text-sm flex justify-between">
				<span>Exit code: { intToString(props.ExitCode) }</span>
				if props.ShowCopyBtn {
					<div>
						@components.Button(components.ButtonProps{
							Size:    "small",
							Variant: components.ButtonVariantOutline,
							Class:   "h-7",
						}) {
							Copy Output
						}
					</div>
				}
			</div>
		}
	</div>
	<style>
		.terminal-logs {
			line-height: 1.4;
		}
		@keyframes blink {
			0%, 100% { opacity: 1; }
			50% { opacity: 0; }
		}
		.animate-blink {
			animation: blink 1s step-end infinite;
		}
	</style>
	<script>
		document.addEventListener('DOMContentLoaded', () => {
			// Auto-scroll functionality
			const terminals = document.querySelectorAll('[data-autoscroll="true"] .terminal-logs');
			terminals.forEach(terminal => {
				terminal.scrollTop = terminal.scrollHeight;

				// Set up an observer to auto-scroll when content changes
				const observer = new MutationObserver(() => {
					terminal.scrollTop = terminal.scrollHeight;
				});

				observer.observe(terminal, { childList: true, subtree: true });
			});

			// Define copy function if it doesn't exist
			if (typeof window.copyTerminalOutput !== 'function') {
				window.copyTerminalOutput = function(id) {
					const terminal = document.querySelector('#' + id + ' .terminal-logs');
					if (!terminal) return;

					// Get text content without formatting
					const text = Array.from(terminal.querySelectorAll('div'))
						.map(line => line.textContent.trim())
						.join('\n');

					// Copy to clipboard
					navigator.clipboard.writeText(text).then(() => {
						// Show a temporary "Copied!" tooltip
						const btn = document.querySelector('#' + id + ' button');
						const originalText = btn.textContent;
						btn.textContent = 'Copied!';
						setTimeout(() => {
							btn.textContent = originalText;
						}, 2000);
					});
				}
			}
			
			// Handle SSE events for log updates
			if (typeof window.handleSSELogEvent !== 'function') {
				window.handleSSELogEvent = function(event) {
					if (event.type === 'log') {
						try {
							const logData = JSON.parse(event.data);
							const terminalId = event.target.closest('[id]').getAttribute('id');
							const terminalLogs = document.querySelector('#' + terminalId + '-logs');
							
							if (!terminalLogs) return;
							
							// Create a new log line
							const logLine = document.createElement('div');
							logLine.className = getLogLineClass(logData.Type);
							
							// Add timestamp if available
							if (logData.Time) {
								const timeSpan = document.createElement('span');
								timeSpan.className = 'text-gray-500 mr-2';
								timeSpan.textContent = formatTimeFromISO(logData.Time);
								logLine.appendChild(timeSpan);
							}
							
							// Add command prefix for command type logs
							if (logData.Type === 'command') {
								const cmdPrefix = document.createElement('span');
								cmdPrefix.className = 'text-blue-400';
								cmdPrefix.textContent = '$ ';
								logLine.appendChild(cmdPrefix);
								
								const cmdContent = document.createElement('span');
								cmdContent.className = 'text-green-400';
								cmdContent.textContent = logData.Content;
								logLine.appendChild(cmdContent);
							} else {
								logLine.appendChild(document.createTextNode(logData.Content));
							}
							
							// Add to terminal
							terminalLogs.appendChild(logLine);
							
							// Auto-scroll
							if (terminalLogs.closest('[data-autoscroll="true"]')) {
								terminalLogs.scrollTop = terminalLogs.scrollHeight;
							}
						} catch (e) {
							console.error('Error processing log data:', e);
						}
					} else if (event.type === 'complete') {
						// Update status to completed
						const container = event.target.closest('[id]');
						const statusIndicator = container.querySelector('.animate-pulse');
						if (statusIndicator) {
							statusIndicator.classList.remove('animate-pulse');
						}
						
						// Add "Create Another VM" button if not present
						const actionBar = container.parentNode.querySelector('.flex.justify-between');
						if (actionBar && !actionBar.querySelector('a[href="/infra/newvm"]')) {
							const createAnotherBtn = document.createElement('a');
							createAnotherBtn.href = '/infra/newvm';
							createAnotherBtn.innerHTML = `
								<button type="button" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
									Create Another VM
								</button>
							`;
							actionBar.appendChild(createAnotherBtn);
						}
					}
				}
				
				// Helper function to format ISO time string
				window.formatTimeFromISO = function(isoString) {
					const date = new Date(isoString);
					return date.toTimeString().split(' ')[0];
				}
				
				// Helper function to get log line class
				window.getLogLineClass = function(logType) {
					switch (logType) {
						case 'error': return 'text-red-400';
						case 'success': return 'text-green-400';
						case 'info': return 'text-blue-400';
						case 'stderr': return 'text-yellow-400';
						case 'warning': return 'text-orange-400';
						case 'command': return '';
						default: return '';
					}
				}
				
				// Register global event listener for SSE messages
				document.body.addEventListener('htmx:sseMessage', function(evt) {
					handleSSELogEvent(evt.detail);
				});
			}
		});
	</script>
}

// Example usage of the component
templ CommandStatusExample() {
	@CommandStatus(CommandStatusProps{
		ID:          "example-terminal",
		Title:       "Deploy Command",
		Command:     "ssh user@server 'docker-compose up -d'",
		IsRunning:   true,
		AutoScroll:  true,
		ShowCopyBtn: true,
		MaxHeight:   "300px",
		Logs: []CommandLogLine{
			{Content: "ssh user@server 'docker-compose up -d'", Type: LogTypeCommand, Time: time.Now().Add(-10 * time.Second)},
			{Content: "Connecting to server...", Type: LogTypeInfo, Time: time.Now().Add(-8 * time.Second)},
			{Content: "SSH connection established", Type: LogTypeSuccess, Time: time.Now().Add(-6 * time.Second)},
			{Content: "Running docker-compose up -d", Type: LogTypeInfo, Time: time.Now().Add(-5 * time.Second)},
			{Content: "Creating network \"app_default\" with the default driver", Type: LogTypeStdout, Time: time.Now().Add(-4 * time.Second)},
			{Content: "Creating app_db_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-3 * time.Second)},
			{Content: "Creating app_redis_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-2 * time.Second)},
			{Content: "Creating app_web_1 ... done", Type: LogTypeStdout, Time: time.Now().Add(-1 * time.Second)},
		},
	})
}

// Helper functions
func getMaxHeight(height string) string {
	if height == "" {
		return "400px"
	}
	return height
}

func getLogLineClass(logType LogType) string {
	switch logType {
	case LogTypeError:
		return "text-red-400"
	case LogTypeSuccess:
		return "text-green-400"
	case LogTypeInfo:
		return "text-blue-400"
	case LogTypeStderr:
		return "text-yellow-400"
	case LogTypeWarning:
		return "text-orange-400"
	default:
		return ""
	}
}

func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func intToString(i int) string {
	return fmt.Sprintf("%d", i)
}

func formatTime(t time.Time) string {
	return t.Format("15:04:05")
}
