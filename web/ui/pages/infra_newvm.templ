package pages

import "github.com/hillsidelabs/rd/web/ui/layouts"

templ InfraNewVM() {
	@layouts.BaseLayout() {
		// Let's change this from a modal to a set of forms. AI!
		<div id="create-vm-modal">
			<div class="fixed inset-0 bg-black/50 z-40"></div>
			<div class="fixed inset-0 z-50 flex items-center justify-center">
				<div class="bg-background rounded-lg shadow-lg w-full max-w-md">
					<div class="p-6">
						<h3 class="text-lg font-semibold mb-4">Create New VM</h3>
						<form class="space-y-4">
							<div>
								<label for="vm-name" class="block text-sm font-medium mb-1">Name</label>
								<input type="text" id="vm-name" class="w-full px-3 py-2 border rounded-md" placeholder="Enter VM name"/>
							</div>
							<div>
								<label for="vm-provider" class="block text-sm font-medium mb-1">Provider</label>
								<select id="vm-provider" class="w-full px-3 py-2 border rounded-md">
									<option value="aws">AWS</option>
									<option value="digitalocean">Digital Ocean</option>
								</select>
							</div>
							<div>
								<label for="vm-type" class="block text-sm font-medium mb-1">Instance Type</label>
								<select id="vm-type" class="w-full px-3 py-2 border rounded-md">
									<option value="t2.micro">t2.micro</option>
									<option value="t2.small">t2.small</option>
									<option value="t2.medium">t2.medium</option>
								</select>
							</div>
							<div>
								<label for="vm-tags" class="block text-sm font-medium mb-1">Tags (comma separated)</label>
								<input type="text" id="vm-tags" class="w-full px-3 py-2 border rounded-md" placeholder="web,production"/>
							</div>
							<div class="flex justify-end gap-2 pt-4">
								<button type="button" class="px-4 py-2 border rounded-md">Cancel</button>
								<button type="submit" class="px-4 py-2 bg-primary text-primary-foreground rounded-md">Create VM</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	}
}
