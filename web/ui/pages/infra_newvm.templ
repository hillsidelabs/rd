package pages

import (
	"github.com/axzilla/templui/components"
	"github.com/hillsidelabs/rd/web/ui/layouts"
)

templ InfraNewVM() {
	@layouts.BaseLayout() {
		<div class="container mx-auto py-8 px-4 max-w-3xl">
			<div class="mb-6">
				<h1 class="text-2xl font-bold">Create New Virtual Machine</h1>
				<p class="text-muted-foreground mt-2">Configure and deploy a new infrastructure host</p>
			</div>
			<div class="bg-card border rounded-lg p-6">
				<form action="/infra/create" method="POST" class="space-y-6">
					<div class="grid gap-6 md:grid-cols-2">
						<div class="space-y-4">
							<h3 class="text-lg font-medium">Basic Information</h3>
							<div>
								@components.Label(components.LabelProps{For: "vm-name"}) {
									Name
								}
								@components.Input(components.InputProps{
									ID:          "vm-name",
									Name:        "name",
									Placeholder: "Enter VM name",
									Required:    true,
								})
							</div>
							<div>
								@components.Label(components.LabelProps{For: "vm-hostname"}) {
									Hostname
								}
								@components.Input(components.InputProps{
									ID:          "vm-hostname",
									Name:        "hostname",
									Placeholder: "server-hostname",
								})
							</div>
							<div>
								@components.Label(components.LabelProps{For: "vm-tags"}) {
									Tags (comma separated)
								}
								@components.Input(components.InputProps{
									ID:          "vm-tags",
									Name:        "tags",
									Placeholder: "web,production,app",
								})
							</div>
						</div>
						<div class="space-y-4">
							// Remove the Provider Configuration forms. AI!
							<h3 class="text-lg font-medium">Provider Configuration</h3>
							<div>
								@components.Label(components.LabelProps{For: "vm-provider"}) {
									Cloud Provider
								}
								@components.Select(components.SelectProps{}) {
									@components.SelectTrigger(components.SelectTriggerProps{ID: "vm-provider"}) {
										@components.SelectValue(components.SelectValueProps{Placeholder: "Select provider"})
									}
									@components.SelectContent(components.SelectContentProps{}) {
										@components.SelectItem(components.SelectItemProps{Value: "aws"}) {
											AWS
										}
										@components.SelectItem(components.SelectItemProps{Value: "digitalocean"}) {
											Digital Ocean
										}
									}
								}
								<input type="hidden" name="provider" id="provider-value"/>
							</div>
							<div>
								@components.Label(components.LabelProps{For: "vm-region"}) {
									Region
								}
								@components.Select(components.SelectProps{}) {
									@components.SelectTrigger(components.SelectTriggerProps{ID: "vm-region"}) {
										@components.SelectValue(components.SelectValueProps{Placeholder: "Select region"})
									}
									@components.SelectContent(components.SelectContentProps{}) {
										@components.SelectItem(components.SelectItemProps{Value: "us-west-2"}) {
											US West (Oregon)
										}
										@components.SelectItem(components.SelectItemProps{Value: "us-east-1"}) {
											US East (N. Virginia)
										}
										@components.SelectItem(components.SelectItemProps{Value: "eu-west-1"}) {
											EU (Ireland)
										}
									}
								}
								<input type="hidden" name="region" id="region-value"/>
							</div>
							<div>
								@components.Label(components.LabelProps{For: "vm-type"}) {
									Instance Type
								}
								@components.Select(components.SelectProps{}) {
									@components.SelectTrigger(components.SelectTriggerProps{ID: "vm-type"}) {
										@components.SelectValue(components.SelectValueProps{Placeholder: "Select instance type"})
									}
									@components.SelectContent(components.SelectContentProps{}) {
										@components.SelectItem(components.SelectItemProps{Value: "t2.micro"}) {
											t2.micro (1 vCPU, 1 GiB RAM)
										}
										@components.SelectItem(components.SelectItemProps{Value: "t2.small"}) {
											t2.small (1 vCPU, 2 GiB RAM)
										}
										@components.SelectItem(components.SelectItemProps{Value: "t2.medium"}) {
											t2.medium (2 vCPU, 4 GiB RAM)
										}
									}
								}
								<input type="hidden" name="instance_type" id="instance-type-value"/>
							</div>
						</div>
					</div>
					<div class="pt-4 border-t">
						<h3 class="text-lg font-medium mb-4">Advanced Options</h3>
						<div class="grid gap-6 md:grid-cols-2">
							<div>
								@components.Label(components.LabelProps{For: "vm-vpc"}) {
									VPC Name
								}
								@components.Input(components.InputProps{
									ID:          "vm-vpc",
									Name:        "vpc",
									Placeholder: "Leave blank for default",
								})
							</div>
							<div>
								@components.Label(components.LabelProps{For: "vm-subnet"}) {
									Subnet CIDR
								}
								@components.Input(components.InputProps{
									ID:          "vm-subnet",
									Name:        "subnet",
									Placeholder: "10.0.1.0/24",
								})
							</div>
						</div>
					</div>
					<div class="flex justify-between pt-6 border-t">
						<a href="/infra">
							@components.Button(components.ButtonProps{
								Variant: components.ButtonVariantOutline,
								Type:    "button",
							}) {
								Cancel
							}
						</a>
						@components.Button(components.ButtonProps{
							Type: "submit",
						}) {
							Create VM
						}
					</div>
				</form>
			</div>
		</div>
		<script>
			// Form validation and submission handling
			document.addEventListener('DOMContentLoaded', () => {
				const form = document.querySelector('form');
				
				form.addEventListener('submit', (e) => {
					// Basic form validation could be added here
					console.log('Form submitted');
				});
			});
		</script>
	}
}
