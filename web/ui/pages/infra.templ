package pages

import (
	"github.com/axzilla/templui/components"
	"github.com/axzilla/templui/icons"
	"github.com/hillsidelabs/rd/infra"
	"github.com/hillsidelabs/rd/web/ui/layouts"
)

templ Infra(catalog *infra.Catalog) {
	@layouts.BaseLayout() {
		<div class="container mx-auto py-8">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-2xl font-bold">Infrastructure Management</h1>
				<div>
					<a href="/infra/newvm">
						@components.Button(components.ButtonProps{Class: "flex items-center gap-2"}) {
							@icons.Plus(icons.IconProps{Size: "16"})
							Create New VM
						}
					</a>
				</div>
			</div>
			if len(catalog.Hosts) == 0 {
				<div class="bg-card border rounded-lg p-8 text-center">
					<h3 class="text-lg font-medium mb-2">No hosts found</h3>
					<p class="text-muted-foreground mb-4">You don't have any infrastructure hosts configured yet.</p>
					@components.Button(components.ButtonProps{}) {
						Create your first host
					}
				</div>
			} else {
				<div class="overflow-hidden border rounded-lg">
					<table class="w-full text-sm">
						<thead class="bg-muted/50">
							<tr>
								<th class="px-4 py-3 text-left font-medium">Name</th>
								<th class="px-4 py-3 text-left font-medium">Hostname</th>
								<th class="px-4 py-3 text-left font-medium">IP Address</th>
								<th class="px-4 py-3 text-left font-medium">Private IP</th>
								<th class="px-4 py-3 text-left font-medium">Provider</th>
								<th class="px-4 py-3 text-left font-medium">Tags</th>
								<th class="px-4 py-3 text-left font-medium">Actions</th>
							</tr>
						</thead>
						<tbody>
							for i, host := range catalog.Hosts {
								<tr
									if i%2 == 1 {
										class="bg-muted/20"
									}
								>
									<td class="px-4 py-3 font-medium">{ host.Name }</td>
									<td class="px-4 py-3">{ host.Hostname }</td>
									<td class="px-4 py-3">{ host.IP }</td>
									<td class="px-4 py-3">{ host.PrivateIP }</td>
									<td class="px-4 py-3">
										if host.Infrastructure != nil {
											{ host.Infrastructure.Provider() }
										} else {
											<span class="text-muted-foreground">-</span>
										}
									</td>
									<td class="px-4 py-3">
										<div class="flex flex-wrap gap-1">
											for _, tag := range host.Tags {
												<span class="px-2 py-0.5 bg-primary/10 text-primary rounded-full text-xs">{ tag }</span>
											}
										</div>
									</td>
									<td class="px-4 py-3">
										<div class="flex items-center gap-2">
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8",
											}) {
												@icons.Pencil(icons.IconProps{Size: "16"})
												<span class="sr-only">Edit</span>
											}
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8",
											}) {
												@icons.CirclePause(icons.IconProps{Size: "16"})
												<span class="sr-only">Pause</span>
											}
											@components.Button(components.ButtonProps{
												Variant: components.ButtonVariantOutline,
												Size:    components.ButtonSizeIcon,
												Class:   "h-8 w-8 text-destructive hover:bg-destructive/10",
											}) {
												@icons.Trash2(icons.IconProps{Size: "16", Color: "red"})
												<span class="sr-only">Delete</span>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
