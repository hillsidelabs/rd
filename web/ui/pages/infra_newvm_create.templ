package pages

import (
	"github.com/axzilla/templui/components"
	"github.com/hillsidelabs/rd/web/ui/layouts"
	"github.com/hillsidelabs/rd/web/ui/modules"
)

type InfraNewVMCreateProps struct {
	VMName       string
	InstanceType string
	Logs         []modules.CommandLogLine
	IsRunning    bool
	ExitCode     int
	JobID        string
}

templ InfraNewVMCreate(props InfraNewVMCreateProps) {
	@layouts.BaseLayout() {
		<div class="container mx-auto py-8 px-4 max-w-4xl">
			<div class="mb-6">
				<h1 class="text-2xl font-bold">Creating VM: { props.VMName }</h1>
				<p class="text-muted-foreground mt-2">Instance type: { props.InstanceType }</p>
			</div>
			<div class="space-y-6">
				@modules.CommandStatus(modules.CommandStatusProps{
					ID:          "vm-creation-status",
					Title:       "VM Creation Progress",
					Command:     "aws ec2 run-instances",
					Logs:        props.Logs,
					IsRunning:   props.IsRunning,
					ExitCode:    props.ExitCode,
					MaxHeight:   "400px",
					AutoScroll:  true,
					ShowCopyBtn: true,
					Class:       "w-full",
				})
				<div class="flex justify-between pt-6">
					<a href="/infra">
						@components.Button(components.ButtonProps{
							Variant: components.ButtonVariantOutline,
							Type:    "button",
						}) {
							Back to Infrastructure
						}
					</a>
					if !props.IsRunning {
						<a href="/infra/newvm">
							@components.Button(components.ButtonProps{
								Type: "button",
							}) {
								Create Another VM
							}
						</a>
					}
				</div>
			</div>
		</div>
	}
}
